{% extends 'base.html.twig' %}

{% block title %}{% trans %}Attendance{% endtrans %}{% endblock %}

{% block body %}
    <ol class="breadcrumb">
	<li class="breadcrumb-item"><a href="https://www.gob.mx"><i class="icon icon-home"></i></a></li>
	<li class="breadcrumb-item"><a href="{{ path('app_index') }}">{% trans %}Begin{% endtrans %}</a></li>
	<li class="breadcrumb-item"><a href="{{ path('app_scheduled_index') }}">{% trans %}Scheduled{% endtrans %}</a></li>
	<li class="breadcrumb-item"><a href="{{ path('app_scheduled_attendance_index') }}">{% trans %}Attendance{% endtrans %}</a></li>
	<li class="breadcrumb-item active" aria-current="page"><a href="{{ path('app_scheduled_attendance_show', {'id': scheduled_attendance.uuid }) }}">{% trans %}Show{% endtrans %}</a></li>
    </ol>

    <h1>{% trans %}Attendance{% endtrans %}</h1>
    <hr class="red">
    
    {% for label, messages in app.flashes %}
	{% for message in messages %}
	    <div class="alert alert-{{ label }}">
		{{ message|trans }}
	    </div>
	{% endfor %}
    {% endfor %}

    <div class="row">
	<div class="col-md">
	    <div class="table-responsive">
		<table class="table table-striped">
		    <tbody>
			{% if is_granted('ROLE_SUPER_ADMIN') %}
			    <tr>
				<th>{% trans %}Id{% endtrans %}</th>
				<td>{{ scheduled_attendance.id }}</td>
			    </tr>
			{% endif %}
			<tr>
			    <th>{% trans %}Scheduled{% endtrans %}</th>
			    <td>{{ scheduled_attendance.scheduled.name }}</td>
			</tr>
			<tr>
			    <th>{% trans %}Check in{% endtrans %}</th>
			    <td>{{ scheduled_attendance.checkInAt ? scheduled_attendance.checkInAt|date('Y-m-d H:i:s') : '' }}</td>
			</tr>
			<tr>
			    <th class="text-wrap">{% trans %}User who checked in{% endtrans %}</th>
			    <td>{{ scheduled_attendance.checkInUser.username }}</td>
			</tr>
		    </tbody>
		</table>
	    </div>
	</div>
    </div>

    <div class="d-grid gap-2 d-md-block">
	{% if is_granted('ROLE_SUPER_ADMIN') %}
	    <a class="btn btn-primary" href="{{ path('app_scheduled_attendance_edit', {'id': scheduled_attendance.uuid}) }}">{% trans %}Edit{% endtrans %}</a>
	{% endif %}
	<a class="btn btn-link" href="{{ path('app_scheduled_attendance_index') }}">{% trans %}Back to list{% endtrans %}</a>
    </div>

    {% if is_granted('ROLE_SUPER_ADMIN') %}
	<div class="row">
	    <div class="col-md-10"></div>
	    <div class="col-md-1">
		{{ include('scheduled_attendance/_delete_form.html.twig') }}
	    </div>
	</div>
    {% endif %}
{% endblock %}

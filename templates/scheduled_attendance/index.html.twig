{% extends 'base.html.twig' %}

{% block title %}{% trans %}Attendance index{% endtrans %}{% endblock %}

{% block body %}
    <ol class="breadcrumb">
	<li class="breadcrumb-item"><a href="https://www.gob.mx"><i class="icon icon-home"></i></a></li>
	<li class="breadcrumb-item"><a href="{{ path('app_index') }}">{% trans %}Begin{% endtrans %}</a></li>
	<li class="breadcrumb-item"><a href="{{ path('app_scheduled_index') }}">{% trans %}Scheduled{% endtrans %}</a></li>
	<li class="breadcrumb-item active" aria-current="page"><a href="{{ path('app_scheduled_attendance_index') }}">{% trans %}Attendance{% endtrans %}</a></li>
    </ol>

    <h1>{% trans %}Attendance index{% endtrans %}</h1>
    <hr class="red">

    {% for label, messages in app.flashes %}
	{% for message in messages %}
	    <div class="alert alert-{{ label }}">
		{{ message|trans }}
	    </div>
	{% endfor %}
    {% endfor %}

    <div class="row">
	<div class="col-12 col-md-6 d-flex justify-content-start">
	    <form class="w-100" method="get" action="{{ path('app_scheduled_attendance_index') }}">
		<div class="input-group mb-3">
		    <input type="text" name="filter" class="form-control input-sm w-75" placeholder="{% trans %}Search by Name{% endtrans %}" value="{{ app.request.query.get('filter') }}">
		    <button class="btn btn-sm btn-info" type="submit">
			<span class="icon-search" aria-hidden="true"></span>
		    </button>
		</div>
	    </form>
	</div>

	<div class="col-12 col-md-6 d-flex justify-content-md-end justify-content-start mt-2 mt-md-0">
	    {% trans %}Total Records{% endtrans %}: {{ scheduled_attendances.getTotalItemCount }}
	</div>
    </div>

    <div class="table-responsive">
	<table class="table table-hover">
            <thead>
		<tr>
                    <th scope="col">{{ knp_pagination_sortable(scheduled_attendances, 'Id'|trans, 'a.id') }}</th>
                    <th scope="col">{{ knp_pagination_sortable(scheduled_attendances, 'Scheduled'|trans, 's.name') }}</th>
                    <th scope="col">{{ knp_pagination_sortable(scheduled_attendances, 'Check in'|trans, 'a.checkInAt') }}</th>
                    <th>{% trans %}actions{% endtrans %}</th>
		</tr>
            </thead>
            <tbody>
		{% for scheduled_attendance in scheduled_attendances %}
		    <tr>
			<td>{{ scheduled_attendance.id }}</td>
			<td>{{ scheduled_attendance.scheduled.name }}</td>
			<td>{{ scheduled_attendance.checkInAt ? scheduled_attendance.checkInAt|date('Y-m-d H:i:s') : '' }}</td>
			<td>
			    <a class="btn btn-link" href="{{ path('app_scheduled_attendance_show', {'id': scheduled_attendance.uuid}) }}">Show</a>
			    {%if is_granted('ROLE_SUPER_ADMIN') %}
				<a class="btn btn-secondary" href="{{ path('app_scheduled_attendance_edit', {'id': scheduled_attendance.uuid}) }}">Edit</a>
			    {% endif %}
			</td>
		    </tr>
{% else %}
		    <tr>
			<td colspan="4">{% trans %}no records found{% endtrans %}</td>
		    </tr>
		{% endfor %}
            </tbody>
	</table>
    </div>

    <div class="navigation">
        {{ knp_pagination_render(scheduled_attendances) }}
    </div>

    <a class="btn btn-primary" href="{{ path('app_scheduled_attendance_new') }}">{% trans %}Create new{% endtrans %}</a>
{% endblock %}

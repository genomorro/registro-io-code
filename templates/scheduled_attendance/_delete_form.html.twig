<form method="post" action="{{ path('app_scheduled_attendance_delete', {'id': scheduled_attendance.uuid}) }}" onsubmit="return confirm('{% trans %}Are you sure you want to delete this item?{% endtrans %}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ scheduled_attendance.id) }}">
    <button class="btn btn-danger">Delete</button>
</form>

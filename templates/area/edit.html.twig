{% extends 'base.html.twig' %}

{% block title %}{% trans %}Edit Area{% endtrans %}{% endblock %}

{% block body %}
    <ol class="breadcrumb">
	<li class="breadcrumb-item"><a href="https://www.gob.mx"><i class="icon icon-home"></i></a></li>
	<li class="breadcrumb-item"><a href="{{ path('app_index') }}">{% trans %}Begin{% endtrans %}</a></li>
	<li class="breadcrumb-item"><a href="{{ path('app_area_index') }}">{% trans %}Area{% endtrans %}</a></li>
	<li class="breadcrumb-item active" aria-current="page"><a href="{{ path('app_area_edit', {'id': area.uuid}) }}">{% trans %}Edit{% endtrans %}</a></li>
    </ol>

    <h1>{% trans %}Edit Area{% endtrans %}</h1>
    <hr class="red">

    <div class="row">
	{{ form_start(form) }}
	    <div class="form-group">
		{{ form_label(form.building) }}:
		<div class="row">
		    <div class="col-md-6">
			{{ form_widget(form.building) }}
			<span class="text-danger">{{ form_errors(form.building) }}</span>
		    </div>
		</div>
	    </div>
	    <div class="form-group">
		{{ form_label(form.unit) }}:
		<div class="row">
		    <div class="col-md-6">
			{{ form_widget(form.unit) }}
			<span class="text-danger">{{ form_errors(form.unit) }}</span>
		    </div>
		</div>
	    </div>
	    <div class="form-group">
		{{ form_label(form.extension) }}:
		<div class="row">
		    <div class="col-md-6">
			{{ form_widget(form.extension) }}
			<span class="text-danger">{{ form_errors(form.extension) }}</span>
		    </div>
		</div>
	    </div>

	    <div class="d-grid gap-2 d-md-block">
		<button type="submit" value="Update" class="btn btn-primary">{% trans %}Update{% endtrans %}</button>
		<a class="btn btn-link" href="{{ path('app_area_index') }}" role="button">{% trans %}Back to list{% endtrans %}</a>
	    </div>
	{{ form_end(form) }}
    </div>


    {% if is_granted('ROLE_SUPER_ADMIN') %}
	<div class="row">
	    <div class="col-md-10"></div>
	    <div class="col-md-1">
		{{ include('area/_delete_form.html.twig') }}
	    </div>
	</div>
    {% endif %}
{% endblock %}

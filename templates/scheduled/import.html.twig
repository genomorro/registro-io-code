{% extends 'base.html.twig' %}

{% block title %}{% trans %}Import Scheduled{% endtrans %}{% endblock %}

{% block body %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="https://www.gob.mx"><i class="icon icon-home"></i></a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_index') }}">{% trans %}Begin{% endtrans %}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_scheduled_index') }}">{% trans %}Scheduled{% endtrans %}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{% trans %}Import{% endtrans %}</li>
    </ol>

    <h1>{% trans %}Import Scheduled from File{% endtrans %}</h1>
    <hr class="red">

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message|trans }}
            </div>
        {% endfor %}
    {% endfor %}

	<div class="card my-5">
	    <div class="card-body">
		<p class="card-text">
                    {% trans %}scheduled.import.paragraph.one{% endtrans %}:
		</p>
		<code>area_id,label,name,institution,subject,begin_at,end_at</code>
		<ul class="mt-4">
                    <li><strong>area_id:</strong> {% trans %}scheduled.import.ul.li.one{% endtrans %}</li>
                    <li><strong>label:</strong> {% trans %}scheduled.import.ul.li.two{% endtrans %}</li>
                    <li><strong>subject:</strong> {% trans %}scheduled.import.ul.li.three{% endtrans %}</li>
                    <li><strong>begin_at / end_at:</strong> {% trans %}scheduled.import.ul.li.four{% endtrans %}</li>
		</ul>	    
	    </div>
	</div>

	<div class="row">
	    {{ form_start(form) }}
		<div class="form-group">
		    {{ form_label(form.file) }}:
		    <div class="row">
			<div class="col-md-6">
			    {{ form_widget(form.file) }}
			    <span class="text-danger">{{ form_errors(form.file) }}</span>
			</div>
		    </div>
		</div>

		<div class="d-grid gap-2 d-md-block">
		    <button class="btn btn-primary" value="Upload" type="submit">{% trans %}Upload File{% endtrans %}</button>
		    <a class="btn btn-link" href="{{ path('app_scheduled_index') }}">{% trans %}Back to list{% endtrans %}</a>
		</div>
	    {{ form_end(form) }}
	</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{% trans %}Edit Scheduled{% endtrans %}{% endblock %}

{% block body %}
    <h1>{% trans %}Edit Scheduled{% endtrans %}</h1>
    <hr class="red">

    <div class="row">
	{{ form_start(form) }}
	    <div class="form-group">
		{{ form_label(form.label) }}:
		<div class="row">
		    <div class="col-md-6">
			{{ form_widget(form.label) }}
			<span class="text-danger">{{ form_errors(form.label) }}</span>
		    </div>
		</div>
	    </div>
	    <div class="form-group">
		{{ form_label(form.name) }}:
		<div class="row">
		    <div class="col-md-6">
			{{ form_widget(form.name) }}
			<span class="text-danger">{{ form_errors(form.name) }}</span>
		    </div>
		</div>
	    </div>
	    <div class="form-group">
		{{ form_label(form.institution) }}:
		<div class="row">
		    <div class="col-md-6">
			{{ form_widget(form.institution) }}
			<span class="text-danger">{{ form_errors(form.institution) }}</span>
		    </div>
		</div>
	    </div>
	    <div class="form-group">
		{{ form_label(form.subject) }}:
		<div class="row">
		    <div class="col-md-6">
			{{ form_widget(form.subject) }}
			<span class="text-danger">{{ form_errors(form.subject) }}</span>
		    </div>
		</div>
	    </div>
	    <div class="form-group">
		{{ form_label(form.beginAt) }}:
		<div class="row">
		    <div class="col-md-6">
			{{ form_widget(form.beginAt) }}
			<span class="text-danger">{{ form_errors(form.beginAt) }}</span>
		    </div>
		</div>
	    </div>
	    <div class="form-group">
		{{ form_label(form.endAt) }}:
		<div class="row">
		    <div class="col-md-6">
			{{ form_widget(form.endAt) }}
			<span class="text-danger">{{ form_errors(form.endAt) }}</span>
		    </div>
		</div>
	    </div>
	    <div class="form-group">
		{{ form_label(form.area) }}:
		<div class="row">
		    <div class="col-md-6">
			{{ form_widget(form.area) }}
			<span class="text-danger">{{ form_errors(form.area) }}</span>
		    </div>
		</div>
	    </div>

	    <div class="d-grid gap-2 d-md-block">
		<button type="submit" value="Save" class="btn btn-primary">{% trans %}Update{% endtrans %}</button>
		<a class="btn btn-link" href="{{ path('app_scheduled_index') }}" role="button">{% trans %}Back to list{% endtrans %}</a>
	    </div>
	{{ form_end(form) }}
    </div>

    {% if is_granted('ROLE_SUPER_ADMIN') %}
	<div class="row">
	    <div class="col-md-10"></div>
	    <div class="col-md-1">
		{{ include('scheduled/_delete_form.html.twig') }}
	    </div>
	</div>
    {% endif %}
{% endblock %}

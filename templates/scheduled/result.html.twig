{% extends 'base.html.twig' %}

{% block title %}{% trans %}Import Results{% endtrans %}{% endblock %}

{% block body %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="https://www.gob.mx"><i class="icon icon-home"></i></a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_index') }}">{% trans %}Begin{% endtrans %}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_scheduled_index') }}">{% trans %}Scheduled{% endtrans %}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_scheduled_import') }}">{% trans %}Import{% endtrans %}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{% trans %}Results{% endtrans %}</li>
    </ol>

    <h1>{% trans %}Import results Scheduled{% endtrans %}</h1>
    <hr class="red">

    <div class="alert alert-{% if result.success %}success{% else %}danger{% endif %} mb-4">
        <h4 class="alert-heading">
            {% if result.success %}
                {% trans %}Status{% endtrans %}: {% trans %}Importation success{% endtrans %}
            {% else %}
                {% trans %}Status{% endtrans %}: {% trans %}Importation fail{% endtrans %}
            {% endif %}
        </h4>
        <p class="mb-0">{% trans %}The import process has been completed.{% endtrans %}</p>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="card-title">{% trans %}Summary{% endtrans %}</h5>
        </div>
        <div class="card-body">
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    {% trans %}Number of records actually created{% endtrans %}
                    <span class="badge bg-success text-white rounded-pill px-3 py-2">{{ result.created }}</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    {% trans %}Number of records actually updated{% endtrans %}
                    <span class="badge bg-info text-white rounded-pill px-3 py-2">{{ result.updated }}</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    {% trans %}Number of records omitted{% endtrans %}
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2">{{ result.omitted }}</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    {% trans %}Number of records that are actually erroneous{% endtrans %}
                    <span class="badge bg-danger text-white rounded-pill px-3 py-2">{{ result.errors }}</span>
                </li>
            </ul>
        </div>
    </div>

    {% if result.unprocessed_rows is not empty %}
        <div class="card border-warning mb-4">
            <div class="card-header bg-warning text-dark font-weight-bold">
                {% trans %}Download of Omitted and Erroneous Records{% endtrans %}
            </div>
            <div class="card-body">
                <p>{% trans %}There are{% endtrans %} <strong>{{ result.unprocessed_rows|length }}</strong> {% trans %}records that were skipped or encountered errors during the process.{% endtrans %}</p>
		<p>{% trans %}You can download a file containing these records for manual review.{% endtrans %}
		    <div class="d-grid gap-2 d-md-block">
                    <a href="{{ path('app_scheduled_import_download_errors') }}" class="btn btn-info">
			<i class="bi bi-download"></i> {% trans %}Download{% endtrans %}
                    </a>
		</div>
            </div>
        </div>
    {% endif %}

    <div class="d-grid gap-2 d-md-block">
	<a href="{{ path('app_scheduled_index') }}" class="btn btn-link">{% trans %}Back to list{% endtrans %}</a>
    </div>
{% endblock %}

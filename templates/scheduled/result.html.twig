{% extends 'base.html.twig' %}

{% block title %}{% trans %}Resultado de Importación{% endtrans %}{% endblock %}

{% block body %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="https://www.gob.mx"><i class="icon icon-home"></i></a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_index') }}">{% trans %}Begin{% endtrans %}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_scheduled_index') }}">{% trans %}Scheduled{% endtrans %}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{% trans %}Resultado de Importación{% endtrans %}</li>
    </ol>

    <h1>{% trans %}Resultado del Proceso de Importación{% endtrans %}</h1>
    <hr class="red">

    <div class="alert alert-{% if result.success %}success{% else %}danger{% endif %} mb-4">
        <h4 class="alert-heading">
            {% if result.success %}
                Estado: Importación exitosa
            {% else %}
                Estado: Importación fallida
            {% endif %}
        </h4>
        <p class="mb-0">El proceso de importación ha finalizado.</p>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light font-weight-bold">
            Resumen del Procesamiento
        </div>
        <div class="card-body">
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Número de registros efectivamente creados
                    <span class="badge bg-success text-white rounded-pill px-3 py-2">{{ result.created }}</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Número de registros efectivamente actualizados
                    <span class="badge bg-info text-white rounded-pill px-3 py-2">{{ result.updated }}</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Número de registros omitidos
                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2">{{ result.omitted }}</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Número de registros efectivamente erróneos
                    <span class="badge bg-danger text-white rounded-pill px-3 py-2">{{ result.errors }}</span>
                </li>
            </ul>
        </div>
    </div>

    {% if result.unprocessed_rows is not empty %}
        <div class="card border-warning mb-4">
            <div class="card-header bg-warning text-dark font-weight-bold">
                Descarga de Registros Omitidos y Erróneos
            </div>
            <div class="card-body">
                <p>Existen <strong>{{ result.unprocessed_rows|length }}</strong> registros que fueron omitidos o presentaron errores durante el proceso.</p>
                <a href="{{ path('app_scheduled_import_download_errors') }}" class="btn btn-outline-dark">
                    <i class="icon-download"></i> Descargar archivo CSV con registros omitidos y erróneos
                </a>
            </div>
        </div>
    {% endif %}

    <div class="d-flex justify-content-start mb-4">
        <a href="{{ path('app_scheduled_index') }}" class="btn btn-primary">Volver a Agendados</a>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{% trans %}Preview Scheduled{% endtrans %}{% endblock %}

{% block body %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="https://www.gob.mx"><i class="icon icon-home"></i></a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_index') }}">{% trans %}Begin{% endtrans %}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_scheduled_index') }}">{% trans %}Scheduled{% endtrans %}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_scheduled_import') }}">{% trans %}Import{% endtrans %}</a></li>
        <li class="breadcrumb-item active" aria-current="page">{% trans %}Preview{% endtrans %}</li>
    </ol>

    <h1>{% trans %}Import preview Scheduled{% endtrans %}</h1>
    <hr class="red">

    {% if analysis.file_errors is not empty %}
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-triangle"></i> {% trans %}Errors in the file structure{% endtrans %}</h4>
            <ul>
                {% for err in analysis.file_errors %}
                    <li>{{ err }}</li>
                {% endfor %}
            </ul>
        </div>
        <a href="{{ path('app_scheduled_import') }}" class="btn btn-secondary">{% trans %}Go back and try again{% endtrans %}</a>
    {% else %}
        <div class="card mb-4">
            <div class="card-header">
                {% trans %}File Summary{% endtrans %}: {{ analysis.filename }}
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-2 col-6 mb-2">
                        <div class="p-2 border rounded bg-light">
                            <div class="h5 mb-0">{{ analysis.summary.total }}</div>
                            <small class="text-muted">{% trans %}Total Rows{% endtrans %}</small>
                        </div>
                    </div>
                    <div class="col-md-2 col-6 mb-2">
                        <div class="p-2 border rounded bg-success text-white">
                            <div class="h5 mb-0">{{ analysis.summary.new }}</div>
                            <small>{% trans %}New Records{% endtrans %}</small>
                        </div>
                    </div>
                    <div class="col-md-2 col-6 mb-2">
                        <div class="p-2 border rounded bg-warning text-dark">
                            <div class="h5 mb-0">{{ analysis.summary.existing }}</div>
                            <small>{% trans %}Existing records (DB){% endtrans %}</small>
                        </div>
                    </div>
                    <div class="col-md-2 col-6 mb-2">
                        <div class="p-2 border rounded bg-info text-white">
                            <div class="h5 mb-0">{{ analysis.summary.duplicate }}</div>
                            <small>{% trans %}Duplicate records in the file{% endtrans %}</small>
                        </div>
                    </div>
                    <div class="col-md-3 col-12 mb-2">
                        <div class="p-2 border rounded bg-danger text-white">
                            <div class="h5 mb-0">{{ analysis.summary.error }}</div>
                            <small>{% trans %}Records with errors{% endtrans %}</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <form method="post" action="{{ path('app_scheduled_import_process') }}">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title">{% trans %}Options for existing records{% endtrans %}</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2">{% trans %}What do you want to do with the records that already exist in the database?{% endtrans %}</p>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="existing_action" id="action_skip" value="skip" checked>
                        <label class="form-check-label" for="action_skip">{% trans %}Skip existing records{% endtrans %}</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="existing_action" id="action_update" value="update">
                        <label class="form-check-label" for="action_update">{% trans %}Update existing records{% endtrans %}</label>
                    </div>
                </div>
            </div>

            <div class="table-responsive mb-4">
                <table class="table table-bordered table-hover table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>{% trans %}Row{% endtrans %}</th>
                            <th>{% trans %}Status{% endtrans %}</th>
                            <th>area_id</th>
                            <th>label</th>
                            <th>name</th>
                            <th>institution</th>
                            <th>subject</th>
                            <th>begin_at</th>
                            <th>end_at</th>
                            <th>{% trans %}Details{% endtrans %}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in analysis.rows %}
                            <tr class="{% if row.status == 'Error' %}table-danger{% elseif row.status == 'Existente' %}table-warning{% elseif row.status == 'Duplicado' %}table-info{% else %}table-success{% endif %}">
                                <td><strong>{{ row.row_number }}</strong></td>
                                <td>
                                    {% if row.status == 'Nuevo' %}
                                        <span class="badge bg-success text-white">{% trans %}New{% endtrans %}</span>
                                    {% elseif row.status == 'Existente' %}
                                        <span class="badge bg-warning text-dark">{% trans %}Extant{% endtrans %}</span>
                                    {% elseif row.status == 'Duplicado' %}
                                        <span class="badge bg-info text-white">{% trans %}Duplicate{% endtrans %}</span>
                                    {% else %}
                                        <span class="badge bg-danger text-white">{% trans %}Error{% endtrans %}</span>
                                    {% endif %}
                                </td>
                                <td>{{ row.area_id }}</td>
                                <td>{{ row.label }}</td>
                                <td>{{ row.name }}</td>
                                <td>{{ row.institution }}</td>
                                <td>{{ row.subject }}</td>
                                <td>{{ row.begin_at }}</td>
                                <td>{{ row.end_at }}</td>
                                <td><small>{{ row.detail }}</small></td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="10" class="text-center">{% trans %}no records found{% endtrans %}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="d-grid gap-2 d-md-block">
                <button type="submit" class="btn btn-success" {% if analysis.summary.total == 0 %}disabled{% endif %}>{% trans %}Continue{% endtrans %}</button>
                <a href="{{ path('app_scheduled_import') }}" class="btn btn-link">{% trans %}Back to list{% endtrans %}</a>
            </div>
        </form>
    {% endif %}
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{% trans %}Employee index{% endtrans %}{% endblock %}

{% block body %}
    <ol class="breadcrumb">
	<li class="breadcrumb-item"><a href="https://www.gob.mx"><i class="icon icon-home"></i></a></li>
	<li class="breadcrumb-item"><a href="{{ path('app_index') }}">{% trans %}Begin{% endtrans %}</a></li>
	<li class="breadcrumb-item active" aria-current="page"><a href="{{ path('app_employee_index') }}">{% trans %}Employee{% endtrans %}</a></li>
    </ol>

    <h1>{% trans %}Employee index{% endtrans %}</h1>
    <hr class="red">

    {% for label, messages in app.flashes %}
	{% for message in messages %}
	    <div class="alert alert-{{ label }}">
		{{ message|trans }}
	    </div>
	{% endfor %}
    {% endfor %}

    <div class="row">
	<div class="col-12 col-md-6 d-flex justify-content-start">
	    <form class="w-100" method="get" action="{{ path('app_employee_index') }}">
		<div class="input-group mb-3">
		    <input type="text" name="filter" class="form-control input-sm w-75" placeholder="{% trans %}Search by Name or Number{% endtrans %}" value="{{ app.request.query.get('filter') }}">
		    <button class="btn btn-sm btn-info" type="submit">
			<span class="icon-search" aria-hidden="true"></span>
		    </button>
		</div>
	    </form>
	</div>

	<div class="col-12 col-md-6 d-flex justify-content-md-end justify-content-start mt-2 mt-md-0">
	    Registros totales: {{ employees.getTotalItemCount }}
	</div>
    </div>

    <div class="table-responsive">
	<table class="table table-hover">
            <thead>
		<tr>
                    <th scope="col">{{ knp_pagination_sortable(employees, 'Id'|trans, 'e.id') }}</th>
                    <th scope="col">{{ knp_pagination_sortable(employees, 'Number'|trans, 'e.number') }}</th>
                    <th scope="col">{{ knp_pagination_sortable(employees, 'Name'|trans, 'e.name') }}</th>
                    <th scope="col">{{ knp_pagination_sortable(employees, 'Area'|trans, 'a.building') }}</th>
                    <th>{% trans %}actions{% endtrans %}</th>
		</tr>
            </thead>
            <tbody>
		{% for employee in employees %}
		    <tr>
			<td>{{ employee.id }}</td>
			<td>{{ employee.number }}</td>
			<td>{{ employee.name }}</td>
			<td>
			    {% if employee.area %}
				<a href="{{ path('app_area_show', {'id': employee.area.uuid}) }}">
				    {{ 'Building'|trans }} {{ employee.area.building }} - {{ employee.area.unit }}
				</a>
			    {% endif %}
			</td>
			<td>
			    <a class="btn btn-link" href="{{ path('app_employee_show', {'id': employee.uuid}) }}">{% trans %}Show{% endtrans %}</a>
			    {% if is_granted('ROLE_SUPER_ADMIN') %}
				<a class="btn btn-secondary" href="{{ path('app_employee_edit', {'id': employee.uuid}) }}">{% trans %}Edit{% endtrans %}</a>
			    {% endif %}
			</td>
		    </tr>
        {% else %}
		    <tr>
			<td colspan="5">{% trans %}no records found{% endtrans %}</td>
		    </tr>
		{% endfor %}
            </tbody>
	</table>
    </div>

    <div class="navigation">
        {{ knp_pagination_render(employees) }}
    </div>

    <a class="btn btn-primary" href="{{ path('app_employee_new') }}">{% trans %}Create new{% endtrans %}</a>
{% endblock %}
